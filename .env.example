# ============================================================
# 프로덕션 환경 변수 템플릿
# 복사 후 .env.prod 로 저장하고 실제 값으로 채워주세요.
# cp .env.example .env.prod
# ============================================================

# 서버 포트 (Nginx가 8080으로 프록시하므로 변경 불필요)
PORT=8080

# 운영 환경
NODE_ENV=production

# CORS 허용 도메인 (프론트엔드 배포 주소, 쉼표로 복수 입력 가능)
# 예: https://your-frontend.vercel.app
CORS_ORIGIN=https://YOUR_FRONTEND_DOMAIN

# Redis 비밀번호 (충분히 긴 랜덤 문자열 권장)
# 생성 예시: openssl rand -base64 32
REDIS_PASSWORD=your_strong_password_here

# Redis 연결 (서비스명은 변경 불필요, 비밀번호는 REDIS_PASSWORD 로 별도 관리)
REDIS_URL=redis://redis:6379

# Swagger 문서에서 WebSocket 연결 예시 URL 생성에 사용
# 프론트엔드 배포 주소와 동일하게 입력
# 예: https://your-frontend.vercel.app
FRONTEND_URL=https://YOUR_FRONTEND_DOMAIN

# Node.js 힙 메모리 제한 (MB)
# t4g.small(2GB RAM): Redis 256MB + OS ~300MB → 앱 ~1200MB
# t4g.medium(4GB RAM): 2400 권장
NODE_MAX_OLD_SPACE=1200
