upstream app_backend {
  server app:8080;
  keepalive 32;
}

# HTTP: certbot 인증 + HTTPS 리다이렉트
# init-ssl.sh 실행 전에는 이 파일을 app.conf 로 복사해서 사용합니다.
# cp nginx/conf.d/app.conf.example nginx/conf.d/app.conf
server {
  listen 80;
  server_name _;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

# HTTPS 블록은 init-ssl.sh 실행 후 app.conf 에 자동으로 추가됩니다.
# 아래는 생성되는 설정 예시입니다.
#
# 배포 구조:
#   브라우저 → api.example.com (CloudFront)
#            → origin-api.example.com (EC2 Nginx) ← [A] 아래 server 블록
#            → app:8080 (Nest)
#
#   브라우저 → wss://ws.example.com (EC2 Nginx 직접) ← [B] 아래 server 블록
#            → app:8080 (Nest / Socket.IO)

